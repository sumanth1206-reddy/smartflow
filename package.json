{
  "name": "smartflow-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "backend": "powershell -Command \"$env:FLASK_APP='backend/app.py'; $env:PYTHONPATH='.'; ./backend/venv_win/Scripts/flask run --port=5000\"",
    "frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -k -n \"API,WEB\" -c \"green,magenta\" \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "react-i18next": "^17.0.10"
  }
}
